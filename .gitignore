# REF: Used ChatGPT to generate this .gitignore file
# But I understood and modified it as needed
# Prevent committing datasets or models
/data/
/../data/
/**/data/
/**/runs/
/**/checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.zip
*.tar
*.tar.gz
*.nii
*.nii.gz
*.npz
*.npy

# Ignore all PNG/JPG images by default (large dataset slices)
*.png
*.jpg
*.jpeg

# Allow small example images in readme_images/
!readme_images/
!readme_images/*.png
!readme_images/*.jpg
!readme_images/*.jpeg

# Python cache and environment
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
.env
.envrc

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
